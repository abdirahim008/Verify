# Supabase — public (safe to ship to client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only. Bypasses RLS. Must NEVER be exposed client-side.
# Used by admin operations and the PDF route's privileged reads.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Puppeteer / chromium-min — only needed in production (Vercel).
# Locally, puppeteer-core finds your installed Chrome via PUPPETEER_EXECUTABLE_PATH
# or we fall back to a downloaded chromium-min binary.
CHROMIUM_REMOTE_EXEC_PATH=https://github.com/Sparticuz/chromium/releases/download/v131.0.1/chromium-v131.0.1-pack.tar

# Email — Resend (https://resend.com). Verification submissions email the
# inbox below. Without these set, requests still land in the admin queue;
# the email notification is skipped (warning logged).
RESEND_API_KEY=
VERIFICATION_INBOX_EMAIL=verify@yourdomain.com
SAHAN_FROM_EMAIL=Sahan <verify@yourdomain.com>
