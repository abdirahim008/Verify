# Supabase — public (safe to ship to client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only. Bypasses RLS. Must NEVER be exposed client-side.
# Used by admin operations and the PDF route's privileged reads.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Puppeteer / chromium-min — only needed in production (Vercel).
# Locally, puppeteer-core finds your installed Chrome via PUPPETEER_EXECUTABLE_PATH
# or we fall back to a downloaded chromium-min binary.
CHROMIUM_REMOTE_EXEC_PATH=https://github.com/Sparticuz/chromium/releases/download/v131.0.1/chromium-v131.0.1-pack.tar

# Email — Resend (https://resend.com). Verification submissions email the
# inbox below. Without these set, requests still land in the admin queue;
# the email notification is skipped (warning logged).
RESEND_API_KEY=
VERIFICATION_INBOX_EMAIL=verify@yourdomain.com
SAHAN_FROM_EMAIL=Sahan <verify@yourdomain.com>

# AI profile import (free text / CV upload → profile draft) and the AI cover
# letter (/cover-letter). DeepSeek's OpenAI-compatible API. Without a key the
# builder simply hides the AI options and shows the manual form, and the
# cover letter page says it isn't available. Model defaults to deepseek-flash
# (DeepSeek V4.1-Flash); set deepseek-v4-pro for the larger model.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Member emails (welcome + onboarding reminders, weekly job alert). Sent with
# the RESEND_API_KEY above, from an address on a domain verified in Resend.
# Until both are set, every member email is a logged no-op.
SAHAN_MEMBERS_FROM_EMAIL=Sahan <hello@yourdomain.com>
SAHAN_REPLY_TO_EMAIL=
# Vercel Cron sends this as a bearer token to /api/cron/*; the routes refuse
# to run without it. Any long random string.
CRON_SECRET=
# Signs the unsubscribe links. Defaults to SUPABASE_SERVICE_ROLE_KEY.
EMAIL_TOKEN_SECRET=
